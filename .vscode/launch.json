{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
    {
      "name": "Launch Mesh Modem RabbitMQ Adapter",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/herald-mesh-rmq-adapter/herald-mesh-adapter",
      "args": [
        "amqp://someuser:somepass@somehostname/",
        "meshModemExchange",
        "modemCommands",
        "modem1",
        "/dev/tty.usbmodem143301"
      ],
      "stopAtEntry": false,
      "cwd": "${fileDirname}",
      "environment": [],
      "console": "integratedTerminal",
      "logging": {
        "moduleLoad": false,
        "trace": true
      },
      "MIMode": "lldb"
    },
    {
      "name": "(Windows) Launch",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/heraldns/heraldns.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/build/heraldns",
      "environment": [],
      "console": "integratedTerminal",
      "logging": {
        "moduleLoad": false,
        "trace": true
      }
    },
    {
      "name": "(Windows) Run Tests with Debug",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/herald-tests/herald-tests.exe",
      "args": ["[exposure]"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/build/herald-tests",
      "environment": [],
      "console": "integratedTerminal"
    }
  ]
}
